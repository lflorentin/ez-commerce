{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["cdg1"],
  "installCommand": "npm ci",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/boutique", "destination": "/index.html" },
    { "source": "/article/:id", "destination": "/index.html" },
    { "source": "/evenements/:path*", "destination": "/index.html" },
    { "source": "/compte", "destination": "/index.html" },
    { "source": "/panier", "destination": "/index.html" },
    { "source": "/conditions", "destination": "/index.html" },
    { "source": "/confidentialite", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
    ] }
  ]
}
