# Local utilise PGlite par défaut. Vercel exige PostgreSQL pour les écritures.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
# Vercel reconnaît ses deux URL système. Définir cette valeur pour un domaine personnalisé.
# PUBLIC_ORIGIN=https://example.com
# Démonstration uniquement. Localement activée par défaut.
DEMO_PAYMENT=true
